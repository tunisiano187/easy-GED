# =============================================================================
# easy-GED — Configuration
# Copier ce fichier en .env et remplir toutes les valeurs
# Les sauvegardes sont gérées par Proxmox Backup Server (PBS)
# =============================================================================

# -----------------------------------------------------------------------------
# PAPERLESS-NGX
# -----------------------------------------------------------------------------
# Clé secrète (générer avec : openssl rand -hex 32)
PAPERLESS_SECRET_KEY=changeme_openssl_rand_hex_32

# Compte administrateur Paperless (interface web)
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=changeme_admin_password
PAPERLESS_ADMIN_MAIL=votre@email.com

# URL publique de Paperless — IP de la VM GED sur Proxmox
PAPERLESS_URL=http://IP_VM:8000

# Langue OCR principale (fra = français, eng = anglais)
PAPERLESS_OCR_LANGUAGE=fra+eng

# Fuseau horaire
PAPERLESS_TIME_ZONE=Europe/Paris

# -----------------------------------------------------------------------------
# POSTGRESQL (base partagée Paperless + n8n)
# -----------------------------------------------------------------------------
POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=changeme_db_password

# Base de données pour n8n (créée automatiquement)
N8N_DB_NAME=n8n

# -----------------------------------------------------------------------------
# N8N — Orchestration
# -----------------------------------------------------------------------------
# Clé de chiffrement des credentials (générer avec : openssl rand -hex 24)
N8N_ENCRYPTION_KEY=changeme_openssl_rand_hex_24

# URL de base pour les webhooks — IP de la VM GED sur Proxmox
N8N_WEBHOOK_BASE_URL=http://IP_VM:5678

# Accès interface n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_n8n_password

# Fuseau horaire n8n
GENERIC_TIMEZONE=Europe/Paris

# -----------------------------------------------------------------------------
# NOTIFICATIONS EMAIL (SMTP)
# -----------------------------------------------------------------------------
# Exemples : smtp.gmail.com:587, smtp.orange.fr:587, mail.infomaniak.com:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre@email.com
SMTP_PASSWORD=votre_mot_de_passe_application
SMTP_FROM=GED Maison <votre@email.com>

# Adresse qui recevra les notifications
NOTIFICATION_EMAIL=votre@email.com

# -----------------------------------------------------------------------------
# NOTIFICATIONS TELEGRAM
# -----------------------------------------------------------------------------
# Créer un bot via @BotFather sur Telegram
# Récupérer le chat_id via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=1234567890:ABCDefGhIJKlmnopQRSTuvwxyz
TELEGRAM_CHAT_ID=123456789

# -----------------------------------------------------------------------------
# SAMBA — Réception fichiers scanner
# -----------------------------------------------------------------------------
# Identifiants à programmer dans l'interface web de votre scanner
SCANNER_SMB_USER=scanner
SCANNER_SMB_PASSWORD=changeme_scanner_password

# -----------------------------------------------------------------------------
# IMAP — Surveillance boîte email (OPTIONNEL)
# Décommenter et remplir pour activer la surveillance email
# -----------------------------------------------------------------------------
# PAPERLESS_EMAIL_HOST=imap.gmail.com
# PAPERLESS_EMAIL_PORT=993
# PAPERLESS_EMAIL_HOST_USER=votre@email.com
# PAPERLESS_EMAIL_HOST_PASSWORD=votre_mot_de_passe_application
# PAPERLESS_EMAIL_FROM=votre@email.com

# -----------------------------------------------------------------------------
# OLLAMA — Modèle IA
# -----------------------------------------------------------------------------
# Modèle recommandé pour les documents français
OLLAMA_MODEL=mistral:7b-instruct

# -----------------------------------------------------------------------------
# CADDY — Reverse proxy HTTPS (optionnel, v2)
# Décommenter pour activer l'accès HTTPS sur votre réseau local
# -----------------------------------------------------------------------------
# PAPERLESS_DOMAIN=paperless.home.local
# N8N_DOMAIN=n8n.home.local
# PORTAINER_DOMAIN=portainer.home.local

# -----------------------------------------------------------------------------
# NUT — Monitoring UPS APC (optionnel — voir docker-compose.nut.yml)
# NUT tourne de préférence sur un device avec accès USB physique à l'UPS
# (Proxmox host, Raspberry Pi, ou autre)
# -----------------------------------------------------------------------------
# NUT_UPS_NAME=apc
# NUT_UPS_DRIVER=usbhid-ups
# NUT_UPSD_USER=upsmon
# NUT_UPSD_PASSWORD=changeme_nut_password
# NUT_SERVER_HOST=IP_DEVICE_NUT   # IP du device qui gère le NUT server
